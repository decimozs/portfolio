# Ollama Cloud - required for the /agent chat
OLLAMA_API_KEY=
OLLAMA_MODEL=minimax-m2.5:cloud

# Neo4j Aura (graph knowledge base for the agent)
NEO4J_URI=neo4j+s://<host>.databases.neo4j.io
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=
NEO4J_QUERY_API_URL=https://<host>.databases.neo4j.io/db/<database>/query/v2

# GitHub - optional, used for the contribution graph
GITHUB_TOKEN=

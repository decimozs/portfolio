# Anthropic - required for the /agent chat
ANTHROPIC_API_KEY=
MODEL=claude-haiku-4-5-20251001

# Neo4j Aura (graph knowledge base for the agent)
NEO4J_URI=neo4j+s://<host>.databases.neo4j.io
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=
NEO4J_QUERY_API_URL=https://<host>.databases.neo4j.io/db/<database>/query/v2

# GitHub - optional, used for the contribution graph
GITHUB_TOKEN=

# PostHog - optional, used to show public blog view counts
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://us.posthog.com

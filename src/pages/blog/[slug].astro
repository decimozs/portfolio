---
import { type CollectionEntry, getCollection, render } from "astro:content";
import HoverLinkCursor from "@/components/hover-link-cursor.astro";
import { formatDate } from "@/lib/date";
import { getReadingTime } from "@/lib/reading-time";
import Layout from "../../layouts/Layout.astro";

type Props = {
  post: CollectionEntry<"blog">;
};

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props as Props;
const { Content } = await render(post);
const readingTime = getReadingTime(post.body);
---

<Layout title={post.data.title} description={post.data.description}>
    <article class="mt-4 xl:mt-0 flex w-full max-w-3xl flex-col gap-8">
            <div class="flex flex-col gap-2">
                <h1>
                    <a
                        href="/blog"
                        data-hover-cursor-target
                        data-hover-cursor-source="blog"
                        data-hover-cursor-title={post.data.title}
                        data-hover-cursor-url="/blog"
                        data-hover-cursor-mode="back"
                        data-hover-cursor-icon="arrow-left"
                    >
                        {post.data.title}
                    </a>
                </h1>
                <p class="text-sm text-muted-foreground">
                    {formatDate(post.data.date)} · {readingTime}<span
                        data-blog-view-count
                        hidden
                    ></span>
                </p>
            </div>
        <div class="blog-content flex flex-col gap-6">
            <Content />
        </div>
        <p class="text-sm text-muted-foreground">© 2026 Marlon Martin</p>
    </article>
    <HoverLinkCursor />
</Layout>

<script define:vars={{ blogSlug: post.id, blogTitle: post.data.title }}>
    import { track } from "@/lib/tracking";

    const trackingWindow = window as Window & {
        __trackedBlogViewPath?: string;
    };

    const trackBlogView = () => {
        const path = window.location.pathname;

        if (trackingWindow.__trackedBlogViewPath === path) {
            return;
        }

        trackingWindow.__trackedBlogViewPath = path;
        track("blog_viewed", {
            blog_slug: blogSlug,
            blog_title: blogTitle,
            blog_path: path,
        });
    };

    trackBlogView();
    document.addEventListener("astro:page-load", trackBlogView);

    const viewCount = document.querySelector<HTMLElement>(
        "[data-blog-view-count]",
    );

    fetch(`/api/blog-views?slug=${encodeURIComponent(blogSlug)}`)
        .then((response) => (response.ok ? response.json() : null))
        .then((data: { views?: number | null } | null) => {
            if (!viewCount || typeof data?.views !== "number") {
                return;
            }

            viewCount.textContent = ` · ${data.views.toLocaleString()} views`;
            viewCount.hidden = false;
        })
        .catch(() => {
            // Analytics is optional, so the metadata remains unchanged if unavailable.
        });
</script>

---
import { type CollectionEntry, getCollection, render } from "astro:content";
import HoverLinkCursor from "@/components/hover-link-cursor.astro";
import { formatDate } from "@/lib/date";
import { getReadingTime } from "@/lib/reading-time";
import Layout from "../../layouts/Layout.astro";

type Props = {
  post: CollectionEntry<"blog">;
};

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props as Props;
const { Content } = await render(post);
const readingTime = getReadingTime(post.body);
---

<Layout title={post.data.title} description={post.data.description}>
    <article
        class="blog-detail-page mt-4 xl:mt-0 flex w-full max-w-3xl flex-col gap-8"
        data-blog-detail
        data-blog-slug={post.id}
        data-blog-title={post.data.title}
    >
            <div class="flex flex-col gap-2">
                <div class="flex items-start justify-between gap-4">
                    <h1 class="min-w-0">
                        <a
                            href="/blog"
                            data-hover-cursor-target
                            data-hover-cursor-source="blog"
                            data-hover-cursor-title={post.data.title}
                            data-hover-cursor-url="/blog"
                            data-hover-cursor-mode="back"
                            data-hover-cursor-icon="arrow-left"
                        >
                            {post.data.title}
                        </a>
                    </h1>
                    <button
                        type="button"
                        class="blog-zen-toggle shrink-0"
                        data-zen-mode-toggle
                        aria-label="Enter zen mode"
                        aria-pressed="false"
                        title="Enter zen mode"
                    >
                        <span>Zen Mode</span>
                    </button>
                </div>
                <p class="text-sm text-muted-foreground">
                    {formatDate(post.data.date)} · {readingTime}<span
                        data-blog-view-count
                        hidden
                    ></span>
                </p>
            </div>
        <div class="blog-content flex flex-col gap-6">
            <Content />
        </div>
        <p class="text-sm text-muted-foreground">© 2026 Marlon Martin</p>
    </article>
    <HoverLinkCursor />
</Layout>

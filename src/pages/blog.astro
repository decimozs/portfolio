---
import { getCollection } from "astro:content";
import HoverLinkCursor from "@/components/hover-link-cursor.astro";
import { formatDate } from "@/lib/date";
import { getReadingTime } from "@/lib/reading-time";
import Layout from "../layouts/Layout.astro";

const title = "Blog";
const description = "Notes and essays by Marlon Martin.";

const blogCollection = await getCollection("blog");
const sortedPosts = [...blogCollection].sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<Layout title={title} description={description}>
    <div class="mt-4 xl:mt-0 flex flex-col gap-14 w-full">
        {
            sortedPosts.map((post) => {
                const readingTime = getReadingTime(post.body);
                const postUrl = `/blog/${post.id}`;

                return (
                <article
                    class="flex flex-col gap-4"
                    data-hover-cursor-target
                    data-hover-cursor-source="blog"
                    data-hover-cursor-title={post.data.title}
                    data-hover-cursor-url={postUrl}
                    data-hover-cursor-mode="same-tab"
                    role="link"
                    tabindex="0"
                    aria-label={`Open ${post.data.title}`}
                >
                    <div class="flex flex-row justify-between gap-6">
                        <a href={postUrl} class="-mb-2 w-fit">
                            {post.data.title}
                        </a>
                        <p class="hidden xl:block text-sm shrink-0">
                            {formatDate(post.data.date)}
                        </p>
                    </div>
                    <p>{post.data.description}</p>
                    <p class="xl:hidden text-sm text-muted-foreground">
                        {formatDate(post.data.date)}
                    </p>
                    <p class="text-sm text-muted-foreground">
                        {readingTime}
                    </p>
                </article>
                );
            })
        }
    </div>
    <HoverLinkCursor />
</Layout>
